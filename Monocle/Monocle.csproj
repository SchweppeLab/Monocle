<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Add these to ensure compatibility -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nova" Version="1.0.0" />
    <!-- Change Microsoft.Data.Sqlite to a version compatible with .NET Framework -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.14" />
    <PackageReference Include="Nova.IO" Version="1.0.0.2" />
  </ItemGroup>
  <!-- Add reference to .NET Framework assemblies if needed -->
</Project>